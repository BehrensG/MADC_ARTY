/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xgpio.h"
#include "sleep.h"
#include "MADC.h"

#define vref (double)7.0658
#define gain (double)0.997674
#define offset (double)0.138195


#define GPIO_DEVICE_ID		XPAR_GPIO_0_DEVICE_ID
XGpio Gpio;

int main()
{
	double meas = 0.0;
	double meas_adj = 0.0;
	s32 status = 0;
	u32 tot_cnt = 0;
	u32 p_cnt = 0;
	u32 n_cnt = 0;

    init_platform();

    status = XGpio_Initialize(&Gpio, GPIO_DEVICE_ID);
    if (status != XST_SUCCESS) {
        return XST_FAILURE;
    }

    while(1)
    {
    	XGpio_DiscreteWrite(&Gpio,1,0x01);

    	usleep(300000);
    	XGpio_DiscreteWrite(&Gpio,1,0x00);
    	usleep(300000);

    	meas = madc_meas((double)2.0*vref);
    	meas_adj =gain*meas + offset;
    	p_cnt = MADC_mReadReg(XPAR_MADC_0_S00_AXI_BASEADDR, MADC_AXI_REG_P_CNT);
    	n_cnt = MADC_mReadReg(XPAR_MADC_0_S00_AXI_BASEADDR, MADC_AXI_REG_N_CNT);
    	tot_cnt = MADC_mReadReg(XPAR_MADC_0_S00_AXI_BASEADDR, MADC_AXI_REG_TOT_CNT);
    	usleep(300000);
    }

    cleanup_platform();
    return 0;
}
